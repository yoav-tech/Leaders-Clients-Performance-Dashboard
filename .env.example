# --- Database (Supabase) ---
# The app + ingestion use the Supabase HTTP Data API (works on Vercel; no pooler/IPv6).
# From Supabase → Project Settings → API:
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role secret..."

# Only the local `npm run db:setup` (DDL) uses a direct connection. Optional otherwise.
DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- Windsor.ai ---
# Find your key at https://windsor.ai (Account → API key).
WINDSOR_API_KEY=""

# --- Cron / ingestion auth ---
# Any long random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# --- Dashboard access gate ---
# When DASHBOARD_PASSWORD is set, the whole dashboard requires HTTP Basic Auth.
# Leave empty to disable the gate (e.g. local dev). DASHBOARD_USER is optional.
DASHBOARD_USER="leaders"
DASHBOARD_PASSWORD=""

# --- FX (optional) ---
# Defaults to a free exchangerate.host endpoint; override to use a keyed provider.
# FX_API_URL="https://api.exchangerate.host/latest?base=USD&symbols=ILS"

# --- QuickShop (store/site revenue) ---
# One key per QuickShop store, named QUICKSHOP_API_KEY_<BRAND_ID_UPPER>.
# Key format qs_live_...; sent as `X-API-Key`. Base: https://my-quickshop.com/api/v1
QUICKSHOP_API_KEY_ARGANIA=""
# QUICKSHOP_API_KEY_STUDIO_PASHA=""

# --- Account managers (per-brand email recipients) ---
# Who receives the weekly/monthly report and the approved monthly media plan for a client.
# One var per brand: EMAIL_MANAGER_<BRAND_ID>, uppercase, dashes → underscores.
# Comma-separated for several recipients. Without this, "אשר ושלח" stays disabled for the brand.
# EMAIL_MANAGER_ARGANIA="manager@ldrsgroup.com"
# EMAIL_MANAGER_LA_BEAUTE=""
# EMAIL_MANAGER_STUDIO_PASHA=""
# EMAIL_MANAGER_SEACRET=""

# --- Media plan narrative (optional) ---
# When set, Claude writes the plan's rationale from the plan's own numbers. Without it the
# builder's deterministic bullets are used instead — the plan itself is unaffected either way.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Media plan automation ---
# The 24th-of-the-month build is INERT until the planning rules are signed off by the media
# team (docs/media-plan-playbook.md + src/lib/mediaPlanRules.ts). Set to "on" to enable it.
# Building and sending plans by hand from /media-plan works regardless.
# MEDIA_PLAN_AUTOMATION="on"

# --- Links in outgoing email ---
# Base URL used for the "open for approval" button in the media-plan review email.
# APP_BASE_URL="https://leaders-clients-performance-dashboa.vercel.app"
